# Ignore bundler config.
/.bundle

# Ignore RubyGems
/.gem

# Ignore installed gems.
/vendor/bundle

# Ignore Rails logs.
/log/*
!/log/.keep

# Ignore temporary files.
/tmp/*
!/tmp/.keep

# Ignore storage.
/storage/*
!/storage/.keep

# Ignore uploaded files
/public/assets
/public/packs
/public/packs-test
/public/uploads

# Ignore master key
/config/master.key

# Ignore credentials
/config/credentials/*.key

# Ignore environment variables
.env
.env.*

# Ignore database files
*.sqlite3
*.sqlite3-*
/db/*.sqlite3

# Ignore macOS files
.DS_Store

# Ignore IDE/editor files
.idea/
.vscode/
*.swp

# Ignore node modules
/node_modules/

# Ignore Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
